<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="board">

    <resultMap type="BoardDto" id="dtoMap">
        <constructor>
            <idArg column="id" javaType="_int" />
            <arg column="writer" javaType="String" />
            <arg column="title" javaType="String" />
            <arg column="content" javaType="String" />
            <arg column="createAt" javaType="java.time.LocalDateTime" />
        </constructor>
    </resultMap>

    <select id="findAll"  resultMap="dtoMap">
        SELECT id, writer, title, content, createAt FROM board ORDER BY id DESC
    </select>

    <select id="findById" parameterType="int" resultMap="dtoMap">
        SELECT id, writer, title, content, createAt FROM board WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="BoardDto">
        INSERT INTO board (writer, title, content, createAt) VALUES (#{writer}, #{title}, #{content}, NOW())
    </insert>

    <update id="update" parameterType="BoardDto">
        UPDATE board SET title = #{title}, content = #{content} WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="int">
        DELETE FROM board WHERE id = #{id}
    </delete>

</mapper>
