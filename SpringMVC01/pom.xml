          <groupId>org.springframework</groupId>
          <artifactId>spring-context</artifactId>
          <version>7.1.0</version>
      </dependency>
      <!-- Source: https://mvnrepository.com/artifact/org.springframework/spring-web -->
      <dependency>
          <groupId>org.springframework</groupId>
          <artifactId>spring-web</artifactId>
          <version>7.1.0</version>
